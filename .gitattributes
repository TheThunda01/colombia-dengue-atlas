* text=auto eol=lf
# Preserve downloaded source response bytes exactly for SHA-256 verification.
data/raw/** -text
data/provenance/** -text
*.png binary
*.pdf binary
# Matplotlib separates SVG path coordinates with spaces at line ends.
# Retain generated bytes for export fingerprints and collapse generated artwork.
figures/*.svg whitespace=-blank-at-eol linguist-generated=true
site/figures/*.svg whitespace=-blank-at-eol linguist-generated=true
